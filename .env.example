# Backend process environment. Copy to .env only for local use and load it
# with Uvicorn's --env-file option. Values here are safe defaults/placeholders.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DUPLICATE_DISTANCE_METERS=5

# Runtime SQLite file and complaint uploads/annotations live under this path.
# Keep unset locally to use the repository's ./data directory. On Render, set
# this to the persistent disk mount path (for example, /var/data).
CIVIC_DATA_DIR=

# Optional overrides for the road context files used by RoadMatcher.
# Render must provision these files separately because local extracts are not
# included in the repository.
CIVIC_ROAD_GRAPHML=
CIVIC_ROAD_FEATURES_GEOJSON=
CIVIC_ROAD_FEATURES_CSV=

# Defaults to models/YOLO26s_RDD_Base.pt when unset. In production, mount or
# download the licensed checkpoint into persistent model storage and set this.
CIVIC_ROAD_DAMAGE_MODEL=

# These match the current application policy; change only when intentionally
# recalibrating the detector policy.
CIVIC_DAMAGE_CONFIRMED_THRESHOLD=0.25
CIVIC_DAMAGE_POSSIBLE_THRESHOLD=0.10
CIVIC_DAMAGE_INFERENCE_SIZE=640
CIVIC_DAMAGE_FALLBACK_INFERENCE_SIZE=1280
